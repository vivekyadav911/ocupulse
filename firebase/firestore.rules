rules_version = '2';
// Sprint 1 — Firestore TEST MODE (classroom / dev only).
// Paste into Firebase Console → Firestore → Rules, or deploy with Firebase CLI.
// Replace with auth-scoped rules before production (see docs/sprint-1/firebase.md).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
