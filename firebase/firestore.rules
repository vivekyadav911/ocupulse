rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isStudent() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().data.role == 'student';
    }

    function isTeacher() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().data.role == 'teacher';
    }

    function ownsTeam(teamId) {
      return isTeacher()
        && get(/databases/$(database)/documents/teams/$(teamId)).data.teacherId == request.auth.uid;
    }

    function hasOwnerEmail() {
      return resource.data.keys().hasAny(['ownerEmail'])
        && resource.data.ownerEmail is string
        && resource.data.ownerEmail.size() > 0;
    }

    function isAnonymousExperimentData() {
      return resource.data.authAnonymous == true && !hasOwnerEmail();
    }

    function actorEmailMatchesOwner() {
      return hasOwnerEmail()
        && userDoc().data.keys().hasAny(['email'])
        && userDoc().data.email == resource.data.ownerEmail;
    }

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /teams/{teamId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && resource.data.teacherId == request.auth.uid;
    }

    match /teams/{teamId}/students/{studentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if ownsTeam(teamId)
        || (request.auth != null && request.auth.uid == studentId);
      allow delete: if ownsTeam(teamId);
    }

    function isPersonalPracticeScore() {
      return request.resource.data.personalPractice == true
        && request.resource.data.userId == request.auth.uid;
    }

    function isPersonalPracticeScoreExisting() {
      return resource.data.personalPractice == true
        && resource.data.userId == request.auth.uid;
    }

    match /scores/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && (
          (isStudent() && request.resource.data.userId == request.auth.uid)
          || (isTeacher() && request.resource.data.teacherId == request.auth.uid)
          || (isTeacher() && isPersonalPracticeScore())
        );
      allow update: if request.auth != null
        && (
          (isStudent() && request.resource.data.userId == request.auth.uid)
          || (isTeacher() && request.resource.data.teacherId == request.auth.uid)
          || (isTeacher() && isPersonalPracticeScore())
        );
      allow delete: if request.auth != null
        && (
          (isStudent() && (
            isAnonymousExperimentData()
            || resource.data.userId == request.auth.uid
            || actorEmailMatchesOwner()
          ))
          || (isTeacher() && resource.data.teacherId == request.auth.uid)
          || (isTeacher() && isPersonalPracticeScoreExisting())
        );
    }

    match /spike_notes/{id} {
      allow read, write: if request.auth != null;
    }

    match /sessions/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && (
          (isStudent() && request.resource.data.createdBy == request.auth.uid)
          || (isTeacher() && request.resource.data.teacherId == request.auth.uid)
          || (isTeacher()
            && request.resource.data.personalPractice == true
            && request.resource.data.createdBy == request.auth.uid)
        );
      allow update: if request.auth != null
        && (
          (isStudent() && request.resource.data.createdBy == request.auth.uid)
          || (isTeacher() && request.resource.data.teacherId == request.auth.uid)
          || (isTeacher()
            && request.resource.data.personalPractice == true
            && request.resource.data.createdBy == request.auth.uid)
        );
      allow delete: if request.auth != null
        && (
          (isStudent() && (
            (resource.data.authAnonymous == true && !hasOwnerEmail())
            || resource.data.createdBy == request.auth.uid
            || actorEmailMatchesOwner()
          ))
          || (isTeacher() && resource.data.teacherId == request.auth.uid)
          || (isTeacher()
            && resource.data.personalPractice == true
            && resource.data.createdBy == request.auth.uid)
        );
    }
  }
}
