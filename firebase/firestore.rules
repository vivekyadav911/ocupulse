rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isStudent() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().data.role == 'student';
    }

    function isTeacher() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().data.role == 'teacher';
    }

    function ownsTeam(teamId) {
      return isTeacher()
        && get(/databases/$(database)/documents/teams/$(teamId)).data.teacherId == request.auth.uid;
    }

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /teams/{teamId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && resource.data.teacherId == request.auth.uid;
    }

    match /teams/{teamId}/students/{studentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if ownsTeam(teamId);
    }

    match /scores/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && (
          (isStudent() && request.resource.data.userId == request.auth.uid)
          || (isTeacher() && request.resource.data.teacherId == request.auth.uid)
        );
      allow update, delete: if request.auth != null
        && (
          (isStudent() && resource.data.userId == request.auth.uid)
          || (isTeacher() && resource.data.teacherId == request.auth.uid)
        );
    }

    match /sessions/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && (
          (isStudent() && request.resource.data.createdBy == request.auth.uid)
          || (isTeacher() && request.resource.data.teacherId == request.auth.uid)
        );
      allow update, delete: if request.auth != null
        && (
          (isStudent() && resource.data.createdBy == request.auth.uid)
          || (isTeacher() && resource.data.teacherId == request.auth.uid)
        );
    }
  }
}
