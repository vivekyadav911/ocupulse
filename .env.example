# Copy to .env — never commit .env
#
# Quick setup:
#   1. cp .env.example .env   (or: npm run firebase:setup creates it)
#   2. Fill FIREBASE_API_KEY and FIREBASE_APP_ID from Firebase Console
#      https://console.firebase.google.com/project/ocupulse-a9986/settings/general
#      → Your apps → Web app → SDK setup
#   3. npm run firebase:setup
#   4. npx expo start -c
#
# If you have Firebase CLI access: npx firebase-tools@latest login
# then npm run firebase:setup can auto-fill keys.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=ocupulse-a9986.firebaseapp.com
FIREBASE_PROJECT_ID=ocupulse-a9986
FIREBASE_STORAGE_BUCKET=ocupulse-a9986.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Client bundle fallbacks (run: node scripts/sync-firebase-env.cjs to copy from FIREBASE_*)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

ADMOB_ANDROID_APP_ID=
ADMOB_IOS_APP_ID=
ADMOB_ANDROID_BANNER_UNIT_ID=
ADMOB_ANDROID_INTERSTITIAL_UNIT_ID=

EXPO_PUBLIC_STEMM_API_URL=https://api.stemm-lab.placeholder

# Optional — EAS cloud builds without interactive login (https://expo.dev/settings/access-tokens)
# EXPO_TOKEN=
