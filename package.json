{
  "name": "ocupulse",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:lan": "expo start --lan",
    "start:tunnel": "expo start --tunnel",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "rebuild:native": "npm rebuild better-sqlite3",
    "test": "jest",
    "a11y": "node scripts/lint-a11y.cjs",
    "secret-scan": "node scripts/secret-scan.cjs",
    "firebase:setup": "node scripts/setup-firebase-env.cjs",
    "firebase:sync-env": "node scripts/sync-firebase-env.cjs",
    "firebase:login": "npx -y firebase-tools@latest login",
    "firebase:deploy-rules": "npx -y firebase-tools@latest deploy --only firestore:rules",
    "firebase:deploy-indexes": "npx -y firebase-tools@latest deploy --only firestore:indexes",
    "firebase:deploy-firestore": "npx -y firebase-tools@latest deploy --only firestore:rules,firestore:indexes",
    "eas": "eas",
    "eas:login": "eas login",
    "eas:whoami": "eas whoami",
    "eas:init": "eas init",
    "eas:auth-check": "node scripts/ensure-eas-auth.cjs",
    "eas:credentials:android": "eas credentials -p android",
    "build:android:preview:setup": "node scripts/ensure-eas-auth.cjs && eas build --platform android --profile preview --no-wait",
    "build:android:preview": "node scripts/ensure-eas-auth.cjs && eas build --platform android --profile preview --non-interactive --no-wait",
    "build:android:preview:wait": "eas build --platform android --profile preview",
    "build:android:preview:bg": "powershell -ExecutionPolicy Bypass -File scripts/build-android-preview.ps1",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-community/slider": "5.0.1",
    "expo": "~54.0.33",
    "expo-av": "~16.0.8",
    "expo-background-fetch": "~14.0.9",
    "expo-battery": "~10.0.8",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
    "expo-file-system": "~19.0.22",
    "expo-haptics": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-print": "~15.0.8",
    "expo-router": "~6.0.23",
    "expo-screen-orientation": "~9.0.9",
    "expo-secure-store": "~15.0.8",
    "expo-sensors": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-task-manager": "~14.0.9",
    "expo-video": "~3.0.16",
    "firebase": "^12.13.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-chart-kit": "^6.12.2",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-google-mobile-ads": "^16.3.3",
    "react-native-maps": "1.20.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.10",
    "better-sqlite3": "^12.10.0",
    "dotenv": "^17.4.2",
    "eas-cli": "^16.32.0",
    "eslint": "^9.18.0",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react-native-a11y": "^3.5.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.17",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "typescript": "~5.9.2"
  },
  "private": true
}
